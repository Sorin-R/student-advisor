# Development example only. Do not overwrite an existing .env or commit secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
FRONTEND_URL=http://localhost:5173
# false for direct local access. Production: verified proxy addresses/subnets or hop count.
# Unrestricted true is rejected. FRONTEND_URL must be the exact HTTPS origin in production.
TRUST_PROXY=false
CLIENT_BUILD_DIR=./dist
UPLOADS_DIR=./uploads

# Use a separate development DB; development startup applies schema migrations.
# For production, apply npm run db:migrate with a migration account first,
# then use a least-privilege runtime account without DDL/audit-delete rights.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=student_advisor_development
MYSQL_USER=student_advisor_dev
MYSQL_PASSWORD=replace-with-development-db-password
MYSQL_SKIP_CREATE_DATABASE=true
# Optional local Unix socket:
MYSQL_SOCKET=
# Remote production MySQL requires certificate-verified TLS.
MYSQL_SSL=false
MYSQL_SSL_CA=

# Generate independent cryptographically random secrets, at least 32 bytes each.
JWT_ACCESS_SECRET=replace-with-independent-random-access-secret
JWT_REFRESH_SECRET=replace-with-independent-random-refresh-secret
# Exactly 64 hex characters (32 random bytes). Preserve an existing key on upgrades;
# replacing it makes existing MFA secrets unreadable without a planned migration.
TWO_FACTOR_ENCRYPTION_KEY=replace-with-64-hex-characters

# SMTP is required for verification/recovery. No email links are logged to console.
# 587 requires STARTTLS. Use SMTP_SECURE=true with port 465 for implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional Google sign-in. Leave all empty to disable.
# Production callback must equal FRONTEND_URL + /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Operator-approved JSON, stored privately. config/privacy.example.json is an
# UNAPPROVED template and must not be published or used to bypass startup checks.
PRIVACY_NOTICE_PATH=
# Optional central-logger audit copy. Protect/rotate/ship it; database audit shipping
# is also needed to include application events committed inside transactions.
AUDIT_LOG_PATH=

# Optional local ClamAV daemon Unix socket. Configured scanner errors fail closed.
# Set REQUIRE=true after provisioning scanning; without it validation is structural,
# not an antivirus scan. Never expose the scanner socket publicly.
DOCUMENT_CLAMAV_SOCKET=
DOCUMENT_REQUIRE_MALWARE_SCAN=false

# VITE_* values are PUBLIC browser code: never put server secrets here.
VITE_PUBLIC_URL=http://localhost:5173
# Optional browser-restricted Google Maps/Places key:
VITE_GOOGLE_MAPS_API_KEY=
